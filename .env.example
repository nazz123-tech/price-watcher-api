# Copy this file to .env and fill in real values. Never commit .env.

# Set automatically by Render; use 4000 locally
PORT=4000

# Supabase: Project Settings -> API
SUPABASE_URL=
# Service role (secret) key. Full access, backend only!
SUPABASE_SERVICE_KEY=

# Kassalapp API key from https://kassal.app/api (used by the daily job)
KASSALAPP_API_KEY=

# Gmail account that sends the alerts (used by the daily job)
GMAIL_USER=
# 16-character Google App Password (spaces are fine, they get stripped)
GMAIL_APP_PASSWORD=
# Optional display name, e.g. Price Watcher <you@gmail.com>
REMINDER_FROM=

# Frontend address, used for CORS and links in emails
FRONTEND_URL=http://localhost:3000
